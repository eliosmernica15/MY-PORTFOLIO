{
  "name": "elios-mernica-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "allowedBuiltDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "scripts": {
    "predev": "node scripts/build-knowledge.mjs",
    "dev": "next dev --port 3000",
    "prebuild": "node --experimental-strip-types scripts/build-knowledge.mjs && node --experimental-strip-types scripts/validate-env.mjs",
    "build": "node --require ./scripts/ipv4-first.cjs node_modules/next/dist/bin/next build",
    "build:direct": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "analyze": "ANALYZE=true next build",
    "sync:kb": "node scripts/build-knowledge.mjs",
    "postinstall": "node scripts/patch-vercel-og.cjs",
    "prepare": "husky install",
    "secrets:scan": "gitleaks detect --config .gitleaks.toml --verbose",
    "secrets:scan:staged": "gitleaks protect --staged --config .gitleaks.toml --verbose",
    "perf:check": "node scripts/check-performance-budget.mjs",
    "perf:lighthouse": "lighthouse-ci autorun --config=lighthouserc.json",
    "perf:budget": "npm run build && npm run perf:check",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:report": "playwright show-report"
  },
  "dependencies": {
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.58",
    "@vercel/kv": "^1.0.1",
    "@xenova/transformers": "^2.17.2",
    "framer-motion": "^12.34.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.563.0",
    "next": "^15.5.25",
    "next-intl": "^3.15.0",
    "next-mdx-remote": "^6.0.0",
    "nodemailer": "^9.1.1",
    "reading-time": "^1.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^1.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@lhci/cli": "^0.13.0",
    "@next/bundle-analyzer": "^15.5.25",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.25",
    "@nogoo9/gitleaks": "^8.30.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4",
    "typescript": "~5.8.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
