# =====================================================================
# Elios Mernica — Portfolio environment variables
# Copy this file to `.env.local` and fill in the values you need.
# All values are server-side unless prefixed with VITE_.
# =====================================================================

# --- Contact form delivery (Server Action: app/actions/contact.ts) ---

# Option A: SMTP (preferred). All four are required if you use SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where messages go. Defaults to eliosmernica@gmail.com.
CONTACT_TO=eliosmernica@gmail.com

# Option B: EmailJS (fallback if SMTP is not set).
# The Server Action will use these to send via the EmailJS REST API
# from the server, so the public key is not exposed in the client.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- Optional integrations ---

# GitHub username for the activity widget. Defaults to eliosmernica15.
GITHUB_USERNAME=eliosmernica15

# Public site URL. Used by metadata, sitemap, and OG images.
NEXT_PUBLIC_SITE_URL=https://eliosmernica.vercel.app
